{
  "name": "word-chain-helper",
  "version": "0.2.0",
  "private": true,
  "description": "표준국어대사전 끝말잇기 보조도구",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && node scripts/copy.mjs",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test dist/*.test.js",
    "dist:win": "npm run build && electron-builder --win portable --x64"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.0"
  },
  "build": {
    "appId": "io.wordchain.helper",
    "productName": "끝말 사전",
    "files": [
      "dist/**/*",
      "!dist/*.test.js",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable",
      "artifactName": "Word-Chain-Windows-x64.${ext}"
    }
  }
}
